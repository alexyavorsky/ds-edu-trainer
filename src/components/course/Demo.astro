---
/**
 * Демонстрация: `<Demo id="…" title="…" />` — ячейка из lesson.py. Код можно выполнить, изменить и вернуть;
 * до запуска виден сохранённый вывод. Изменённый код не сохраняется. Выполняется в сеансе урока.
 *
 * Сохранённый вывод демонстрации, перед которой в уроке есть упражнение, помечен data-gated: пока упражнения
 * выше не решены, скрипт урока прячет его за плашкой (docs/COURSES_PLAN.md, «Ячейки и состояние»). Без JS
 * вывод виден — решить упражнение без JS нельзя, и скрытый вывод остался бы скрытым навсегда.
 */
import { Code } from 'astro:components';
import { cellOf, findLesson, storedOutput } from '../../lib/courses/site';
import Icon from '../Icon.astro';
import CellOutput from './CellOutput.astro';

interface Props {
  id: string;
  title?: string;
}
const { id, title } = Astro.props;
const { course, lesson } = findLesson(Astro.locals.lesson!);
const cell = cellOf(lesson, id);
if (cell.kind !== 'demo') throw new Error(`${lesson.meta.id}: <Demo id="${id}"> — ячейка не демонстрация`);
const output = storedOutput(lesson, id);
const plots = Array.from({ length: output?.plots ?? 0 }, (_, n) => `/course-plots/${course.slug}/${lesson.slug}/${id}-${n + 1}.svg`);
const raises = cell.flags.raises;
const at = lesson.blocks.findIndex((b) => b.type === 'demo' && b.id === id);
const gated = !!output && lesson.blocks.slice(0, at).some((b) => b.type === 'exercise');
---

<figure class="cell cell-demo" data-cell={id} data-gated={gated ? '' : undefined}>
  <figcaption class="cell-head">
    <span class="count" data-count title="Номер выполнения в этом сеансе">[ ]</span>
    <span class="cell-title">{title ?? 'Код'}</span>
    {raises && <span class="tag">ошибка: {raises}</span>}
    <span class="tools">
      <button type="button" class="btn btn-ghost cbtn" data-above title="Выполнить все ячейки выше" aria-label="Выполнить все ячейки выше">
        <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 19V7"/><path d="m6 11 6-6 6 6"/><path d="M5 3h14"/></svg>
      </button>
      <button type="button" class="btn btn-ghost cbtn" data-edit title="Изменить код и выполнить свой вариант">
        <Icon name="edit" />
        <span class="text" data-edit-label>Изменить</span>
      </button>
      <button type="button" class="btn btn-ghost cbtn run" data-run title="Выполнить ячейку">
        <span class="spinner" aria-hidden="true"></span>
        <Icon name="play" />
        <span class="text">Выполнить</span>
      </button>
    </span>
  </figcaption>
  <div class="cell-code" data-code>
    <Code code={cell.code} lang="python" theme="vitesse-dark" />
  </div>
  {output && <CellOutput output={output} plots={plots} title={title} />}
  {
    gated && (
      <div class="out-gate">
        <span class="gate-text">Вывод появится, когда решите упражнения выше — чтобы он не подсказал ответ.</span>
        <span class="gate-actions">
          <button type="button" class="btn btn-ghost small" data-gate-show title="Показать сохранённый вывод этой ячейки">
            Показать всё равно
          </button>
          <button type="button" class="btn btn-ghost small" data-gate-all title="Показать сохранённый вывод всех ячеек урока">
            Весь вывод урока
          </button>
        </span>
      </div>
    )
  }
  <div class="cell-live" data-live hidden></div>
</figure>
