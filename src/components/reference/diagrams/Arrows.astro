---
/** Двусторонняя подпись-стрелка между таблицами схемы: «melt →» над «← pivot». На узком экране поворачивается вниз. */
interface Props {
  forward: string;
  back?: string;
}
const { forward, back } = Astro.props;
---

<div class="arrows" aria-hidden="true">
  <span class="fwd"><code>{forward}</code> <span class="glyph">→</span></span>
  {back && <span class="back"><span class="glyph">←</span> <code>{back}</code></span>}
</div>

<style>
  .arrows {
    display: grid;
    gap: 6px;
    align-self: center;
    justify-items: center;
    font-size: 12px;
    color: var(--muted);
  }
  code {
    font-family: var(--font-mono);
    color: var(--accent-strong);
    background: none;
    border: 0;
    padding: 0;
  }
  .glyph {
    color: var(--medium);
    font-size: 15px;
  }
  @media (max-width: 620px) {
    .glyph {
      display: inline-block;
      transform: rotate(90deg);
    }
    .arrows {
      grid-auto-flow: column;
      gap: 18px;
    }
  }
</style>
