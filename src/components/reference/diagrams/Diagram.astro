---
/** Рамка схемы: подпись снизу, горизонтальная прокрутка внутри блока, если не помещается. */
interface Props {
  caption: string;
  label: string;
}
const { caption, label } = Astro.props;
---

<figure class="diagram" role="img" aria-label={label}>
  <div class="canvas"><slot /></div>
  <figcaption>{caption}</figcaption>
</figure>

<style>
  .diagram {
    margin: 4px 0 24px;
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    background: radial-gradient(120% 100% at 0% 0%, rgb(141 149 255 / 0.06), transparent 60%), var(--surface);
    overflow: hidden;
  }
  .canvas {
    padding: 18px 16px;
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
  }
  figcaption {
    padding: 9px 16px;
    border-top: 1px solid var(--border);
    font-size: 12.5px;
    color: var(--muted);
  }
</style>
