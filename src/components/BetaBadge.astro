---
/** Пометка «бета» у раздела (beta = true в book.toml / course.toml / topic.toml). `note` — пояснение текстом рядом. */
import { BETA_NOTE } from '../lib/directions';

interface Props {
  note?: boolean;
}
const { note = false } = Astro.props;
---

<span class="beta-wrap">
  <span class="beta" title={BETA_NOTE} aria-label={`бета: ${BETA_NOTE.toLowerCase()}`}>бета</span>
  {note && <span class="beta-note">{BETA_NOTE.toLowerCase()}</span>}
</span>

<style>
  .beta-wrap {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    vertical-align: middle;
  }
  .beta {
    flex: none;
    font-size: 11px;
    font-weight: 500;
    line-height: 1;
    letter-spacing: 0.02em;
    padding: 4px 7px;
    border-radius: 99px;
    color: var(--medium);
    background: var(--medium-soft);
    cursor: help;
  }
  .beta-note {
    font-size: 12.5px;
    font-weight: 400;
    letter-spacing: 0;
    color: var(--muted);
  }
</style>
