---
import type { Challenge, Chapter } from '../lib/content';
import { chapterUrl } from '../lib/content';
import { tasksLabel } from '../lib/labels';
import ProgressBar from './ProgressBar.astro';

interface Props {
  chapter: Chapter;
  challenges: Challenge[];
}
const { chapter, challenges } = Astro.props;
const count = (d: string) => challenges.filter((c) => c.data.difficulty === d).length;
---

<a href={chapterUrl(chapter)} class="chapter card">
  <div class="top">
    <span class="num">{String(chapter.data.number).padStart(2, '0')}</span>
    <span class="dots" aria-label={`Лёгких ${count('easy')}, средних ${count('medium')}, сложных ${count('hard')}`}>
      <span class="d easy">{count('easy')}</span>
      <span class="d medium">{count('medium')}</span>
      <span class="d hard">{count('hard')}</span>
    </span>
  </div>
  <h3 class="title">{chapter.data.title}</h3>
  <p class="summary">{chapter.data.summary}</p>
  <div class="bottom">
    <span class="count">{tasksLabel(challenges.length)}</span>
    <ProgressBar ids={challenges.map((c) => c.data.taskId)} size="sm" />
  </div>
</a>

<style>
  .chapter {
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding: 18px;
    min-width: 0;
    transition:
      border-color 0.15s,
      background 0.15s,
      transform 0.15s;
  }
  .chapter:hover {
    border-color: var(--border-strong);
    background: var(--surface-2);
  }
  .top {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }
  .num {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--faint);
  }
  .dots {
    display: flex;
    gap: 8px;
    font-size: 11.5px;
    font-variant-numeric: tabular-nums;
  }
  .d {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    color: var(--muted);
  }
  .d::before {
    content: '';
    width: 6px;
    height: 6px;
    border-radius: 50%;
  }
  .d.easy::before {
    background: var(--easy);
  }
  .d.medium::before {
    background: var(--medium);
  }
  .d.hard::before {
    background: var(--hard);
  }
  .title {
    font-size: 16px;
  }
  .summary {
    margin: 0;
    color: var(--muted);
    font-size: 13.5px;
    line-height: 1.5;
    flex: 1;
  }
  .bottom {
    display: grid;
    grid-template-columns: auto 1fr;
    align-items: center;
    gap: 14px;
    margin-top: 6px;
  }
  .count {
    font-size: 12.5px;
    color: var(--text-2);
  }
</style>
