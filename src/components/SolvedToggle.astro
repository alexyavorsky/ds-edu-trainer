---
/** Чекбокс «Решено» — сохраняется в localStorage. */
import Icon from './Icon.astro';

interface Props {
  taskId: string;
}
const { taskId } = Astro.props;
---

<label class="solved" data-solved-toggle data-solved-marker={taskId}>
  <input type="checkbox" class="sr-only" data-id={taskId} />
  <span class="box" aria-hidden="true"><Icon name="check" size={12} /></span>
  <span class="text">Решено</span>
</label>

<style>
  .solved {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    height: 34px;
    padding: 0 12px 0 10px;
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-sm);
    background: var(--surface-2);
    font-size: 13.5px;
    font-weight: 500;
    cursor: pointer;
    user-select: none;
    transition:
      background 0.15s,
      border-color 0.15s;
  }
  .solved:hover {
    background: var(--surface-3);
  }
  .solved:has(input:focus-visible) {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }
  .box {
    display: grid;
    place-items: center;
    width: 16px;
    height: 16px;
    border-radius: 4px;
    border: 1.5px solid var(--border-strong);
    color: transparent;
    transition: all 0.15s;
  }
  .solved.is-solved {
    border-color: rgb(76 195 138 / 0.4);
    background: var(--easy-soft);
    color: var(--easy);
  }
  .solved.is-solved .box {
    background: var(--easy);
    border-color: var(--easy);
    color: var(--bg);
  }
</style>

<script>
  import { getSolved, renderProgress, setSolved } from '../scripts/progress';

  document.querySelectorAll<HTMLInputElement>('[data-solved-toggle] input').forEach((input) => {
    const id = input.dataset.id!;
    input.checked = getSolved().has(id);
    input.addEventListener('change', () => setSolved(id, input.checked));
  });
  renderProgress();
</script>
