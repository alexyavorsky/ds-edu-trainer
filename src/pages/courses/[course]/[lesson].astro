---
import { getCollection, render } from 'astro:content';
import Badge from '../../../components/Badge.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import BugReportLink from '../../../components/BugReportLink.astro';
import PrevNext from '../../../components/PrevNext.astro';
import { courseComponents } from '../../../components/course';
import CourseSidebar from '../../../components/course/CourseSidebar.astro';
import PythonLessonScript from '../../../components/course/PythonLessonScript.astro';
import { englishLessonComponents } from '../../../components/english';
import EnglishLessonScript from '../../../components/english/EnglishLessonScript.astro';
import TestPanel from '../../../components/english/TestPanel.astro';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { courseLessons, isPythonCourse, isTestKind, lessonExerciseIds, lessonUrl, type LessonSource } from '../../../lib/courses/load';
import { englishPageData, findLesson, lessonPageData } from '../../../lib/courses/site';
import { articleUrl } from '../../../lib/reference';
import '../../../styles/course.css';

export async function getStaticPaths() {
  return (await getCollection('lessons')).map((entry) => {
    const { course, lesson } = findLesson(entry.id);
    return { params: { course: course.slug, lesson: lesson.slug }, props: { entry } };
  });
}

const { entry } = Astro.props;
const { course, lesson } = findLesson(entry.id);
Astro.locals.lesson = entry.id; // для <Demo>, <Exercise> внутри урока
const { Content } = await render(entry);

const order = courseLessons(course);
const pos = order.findIndex((l) => l.meta.id === lesson.meta.id);
const link = (l?: LessonSource) => l && { href: lessonUrl(l), label: l.meta.title };
const module = course.modules.find((m) => m.slug === lesson.module)!;
const lastInModule = module.lessons[module.lessons.length - 1] === lesson;
const python = isPythonCourse(course); // курс без Python (английский): ни Pyodide, ни .ipynb, ни строки ядра
const exercises = lessonExerciseIds(lesson).length;
const articles = await getCollection('reference');
const titles = new Map(articles.map((a) => [a.id, a.data.title]));
const json = (value: unknown) => JSON.stringify(value).replace(/</g, '\\u003c');
const data = python ? json(lessonPageData(course, lesson)) : json(englishPageData(course, lesson, new Map(articles.map((a) => [a.id, a.data.cefr ?? '']))));
const test = isTestKind(lesson.meta.kind);
const items = lesson.exercises.reduce((n, e) => n + e.items.length, 0);
const KIND_BADGE: Partial<Record<LessonSource['meta']['kind'], string>> = { review: 'повторение', test: 'контрольная', placement: 'входная проверка' };
---

<BaseLayout title={`${lesson.meta.title} — курс ${course.meta.title}`} description={lesson.meta.summary} lessonId={lesson.meta.id} wide>
  <div class="course-layout">
    <aside class="sidebar" id="course-sidebar" data-drawer aria-label="Программа курса">
      <div class="drawer-head">
        <span>Программа</span>
        <button type="button" class="btn btn-ghost" data-drawer-close aria-label="Закрыть">✕</button>
      </div>
      <CourseSidebar course={course} currentId={lesson.meta.id} />
    </aside>
    <div class="overlay" data-drawer-overlay hidden></div>

    <div class="lesson-main">
      <div class="topbar">
        <button type="button" class="btn drawer-open" data-drawer-open aria-controls="course-sidebar" aria-expanded="false">
          <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M4 6h16M4 12h16M4 18h16"/></svg>
          Программа
        </button>
        {python && exercises > 0 && (
          <button type="button" class="btn btn-ghost ipynb" data-ipynb-mine={`${lessonUrl(lesson)}.ipynb`} title="Урок как Jupyter-ноутбук с вашим кодом в упражнениях — продолжить в Jupyter или Google Colab">
            <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 4v11"/><path d="m7 10 5 5 5-5"/><path d="M5 20h14"/></svg>
            <span data-label>Скачать с моим кодом</span>
          </button>
        )}
        {python && <a class="btn btn-ghost ipynb" href={`${lessonUrl(lesson)}.ipynb`} download={`${lesson.meta.id}.ipynb`} title="Урок как Jupyter-ноутбук с заготовками упражнений: текст, код, проверки и данные — для Jupyter и Google Colab">
          <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 4v11"/><path d="m7 10 5 5 5-5"/><path d="M5 20h14"/></svg>
          Скачать чистый
        </a>}
      </div>

      <Breadcrumbs
        items={[
          { label: 'Курсы', href: '/courses' },
          { label: course.meta.title, href: `/courses/${course.slug}` },
          { label: `Модуль ${module.number}. ${module.meta.title}` },
        ]}
        beta={course.meta.beta}
      />
      <header class="head">
        <div class="meta">
          {lesson.meta.kind === 'project' ? <Badge tone="medium">мини-проект</Badge> : KIND_BADGE[lesson.meta.kind] ? <Badge tone="medium">{KIND_BADGE[lesson.meta.kind]}</Badge> : <Badge>урок {module.lessons.indexOf(lesson) + 1} из {module.lessons.length}</Badge>}
          {!python && module.meta.level && <Badge tone="accent">{module.meta.level}</Badge>}
          {lesson.meta.optional && <Badge>дополнительно</Badge>}
          <span class="minutes">≈ {lesson.meta.minutes} мин</span>
          {exercises > 0 && !test && (
            <span class="minutes">
              упражнения: <span data-lesson-solved>0</span> из {exercises}
            </span>
          )}
        </div>
        <h1>{lesson.meta.title}</h1>
        <p class="summary">{lesson.meta.summary}</p>
      </header>

      {python && <div class="kernel" data-kernel>
        <span class="dot" aria-hidden="true"></span>
        <span class="kernel-text" data-kernel-text aria-live="polite">Python запустится при первом выполнении</span>
        <button type="button" class="btn btn-ghost small" data-run-all title="Выполнить все ячейки урока по порядку">
          <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 4.5v15l10-7.5z"/><path d="M19 5v14"/></svg>
          <span class="kernel-label">Выполнить всё</span>
        </button>
        <button type="button" class="btn btn-ghost small" data-restart title="Сбросить состояние: удалить все переменные урока">
          <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 12a9 9 0 1 0 3-6.7L3 8"/><path d="M3 3v5h5"/></svg>
          <span class="kernel-label">Перезапустить</span>
        </button>
      </div>
      <p class="kernel-notice" data-kernel-notice hidden></p>}

      <article class="prose lesson-prose">
        <Content components={python ? courseComponents : englishLessonComponents} />
      </article>
      {!python && test && <TestPanel placement={lesson.meta.kind === 'placement'} items={items} />}

      {
        lesson.meta.reference.length > 0 && (
          <section class="more">
            <h2 class="section-title">Подробнее в справочнике</h2>
            <ul class="chips">
              {lesson.meta.reference.map((id) => (
                <li>
                  <a href={articleUrl(id)}>{titles.get(id) ?? id}</a>
                </li>
              ))}
            </ul>
          </section>
        )
      }
      {
        python && lastInModule && (
          <section class="more">
            <h2 class="section-title">Практика по модулю</h2>
            <p class="muted">
              Задачи по {course.meta.title} для самостоятельной практики появятся в разделе{' '}
              <a href={`/${course.slug}`}>«Задачи → {course.meta.title}»</a>.
            </p>
          </section>
        )
      }

      <footer class="lesson-foot">
        <label class="done-toggle">
          <input type="checkbox" data-lesson-done />
          <span>Урок пройден</span>
          <span class="muted">— {test ? (lesson.meta.kind === 'placement' ? 'отмечается сам после «Завершить»' : 'отмечается сам при зачёте (80 %)') : 'отмечается сам, когда решены все упражнения'}</span>
        </label>
        <BugReportLink lessonId={lesson.meta.id} />
      </footer>

      <PrevNext prev={link(order[pos - 1])} next={link(order[pos + 1])} />
    </div>
  </div>
  <script type="application/json" id={python ? 'lesson-data' : 'english-data'} set:html={data} />
  {python ? <PythonLessonScript /> : <EnglishLessonScript />}
</BaseLayout>

<style>
  .course-layout {
    display: grid;
    grid-template-columns: 250px minmax(0, 1fr);
    gap: 44px;
    align-items: start;
    max-width: 1100px;
  }
  .sidebar {
    position: sticky;
    top: 76px;
    max-height: calc(100vh - 96px);
    overflow-y: auto;
    overscroll-behavior: contain;
    scrollbar-width: thin;
  }
  .drawer-head,
  .drawer-open,
  .overlay {
    display: none;
  }
  .lesson-main {
    min-width: 0;
    max-width: 800px;
  }
  .topbar {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: 10px;
    margin-bottom: 18px;
  }
  .ipynb {
    height: 34px;
  }
  .head {
    margin-bottom: 20px;
  }
  .meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px 14px;
    margin-bottom: 12px;
  }
  .minutes {
    font-size: 12.5px;
    color: var(--muted);
  }
  .head h1 {
    font-size: clamp(26px, 5vw, 34px);
    letter-spacing: -0.03em;
    overflow-wrap: anywhere;
  }
  .summary {
    margin: 10px 0 0;
    font-size: 16px;
    color: var(--text-2);
  }
  .kernel {
    position: sticky;
    top: 57px;
    z-index: 10;
    display: flex;
    align-items: center;
    gap: 6px;
    margin: 0 0 8px;
    padding: 4px 4px 4px 12px;
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    background: rgb(14 15 17 / 0.92);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    font-size: 12.5px;
    color: var(--muted);
  }
  .dot {
    flex: none;
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--faint);
  }
  .kernel.is-busy .dot {
    background: var(--accent);
    animation: pulse 1s ease-in-out infinite alternate;
  }
  @keyframes pulse {
    to {
      opacity: 0.3;
    }
  }
  .kernel-text {
    flex: 1;
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .small {
    height: 30px;
    padding: 0 10px;
    font-size: 12.5px;
  }
  .kernel-notice {
    margin: 0 0 8px;
    padding: 8px 12px;
    border-radius: var(--radius-xs);
    background: var(--medium-soft);
    color: var(--medium);
    font-size: 13px;
  }
  .kernel-notice[hidden] {
    display: none;
  }
  .lesson-prose {
    margin-top: 20px;
  }
  .lesson-prose :global(a) {
    color: var(--accent-strong);
  }
  .lesson-prose :global(a:hover) {
    text-decoration: underline;
  }
  .lesson-prose :global(h2) {
    margin: 34px 0 10px;
    font-size: 20px;
    letter-spacing: -0.02em;
    text-transform: none;
  }
  .more {
    margin-top: 32px;
  }
  .more a,
  .chips a {
    color: var(--accent-strong);
  }
  .chips {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 8px 18px;
    font-size: 14px;
  }
  .more p {
    margin: 0;
    font-size: 14px;
  }
  .lesson-foot {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 14px;
    margin-top: 36px;
    padding-top: 20px;
    border-top: 1px solid var(--border);
  }
  .done-toggle {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 4px 8px;
    font-size: 14px;
    cursor: pointer;
  }
  .done-toggle input {
    width: 16px;
    height: 16px;
    accent-color: var(--easy);
  }
  .done-toggle .muted {
    font-size: 12.5px;
  }

  @media (max-width: 900px) {
    .course-layout {
      grid-template-columns: minmax(0, 1fr);
    }
    .sidebar {
      position: fixed;
      z-index: 50;
      top: 0;
      bottom: 0;
      left: 0;
      width: min(320px, 86vw);
      max-height: none;
      padding: 0 16px 24px;
      background: var(--surface);
      border-right: 1px solid var(--border);
      transform: translateX(-100%);
      transition: transform 0.2s ease;
    }
    .sidebar.is-open {
      transform: none;
      box-shadow: 0 0 60px rgb(0 0 0 / 0.6);
    }
    .drawer-head {
      position: sticky;
      top: 0;
      z-index: 1;
      display: flex;
      align-items: center;
      justify-content: space-between;
      height: 56px;
      margin-bottom: 8px;
      background: var(--surface);
      font-weight: 600;
    }
    .overlay:not([hidden]) {
      display: block;
      position: fixed;
      inset: 0;
      z-index: 40;
      background: rgb(0 0 0 / 0.5);
    }
    .drawer-open {
      display: inline-flex;
      margin-right: auto;
      height: 34px;
    }
  }
  @media (max-width: 560px) {
    .kernel-label {
      display: none;
    }
  }
</style>

<script>
  import { watchCourseProgress } from '../../../scripts/course/progress';

  watchCourseProgress();

  const drawer = document.querySelector<HTMLElement>('[data-drawer]');
  const overlay = document.querySelector<HTMLElement>('[data-drawer-overlay]');
  const opener = document.querySelector<HTMLButtonElement>('[data-drawer-open]');
  const setOpen = (open: boolean) => {
    drawer?.classList.toggle('is-open', open);
    if (overlay) overlay.hidden = !open;
    opener?.setAttribute('aria-expanded', String(open));
    document.body.style.overflow = open ? 'hidden' : '';
    if (open) drawer?.querySelector<HTMLElement>('.is-current')?.scrollIntoView({ block: 'center' });
  };
  opener?.addEventListener('click', () => setOpen(true));
  overlay?.addEventListener('click', () => setOpen(false));
  document.querySelector('[data-drawer-close]')?.addEventListener('click', () => setOpen(false));
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') setOpen(false);
  });
</script>
