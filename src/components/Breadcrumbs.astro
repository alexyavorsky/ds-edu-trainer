---
interface Props {
  items: { label: string; href?: string }[];
}
const { items } = Astro.props;
---

<nav class="crumbs" aria-label="Навигация">
  {
    items.map((item, i) => (
      <>
        {i > 0 && <span class="sep" aria-hidden="true">/</span>}
        {item.href ? <a href={item.href}>{item.label}</a> : <span aria-current="page">{item.label}</span>}
      </>
    ))
  }
</nav>

<style>
  .crumbs {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px;
    font-size: 13px;
    color: var(--muted);
    margin-bottom: 20px;
  }
  .crumbs a:hover {
    color: var(--text);
  }
  .sep {
    color: var(--faint);
  }
  [aria-current] {
    color: var(--text-2);
  }
</style>
