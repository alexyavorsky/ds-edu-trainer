---
/** Прогресс «x из y»: считается на клиенте по localStorage (см. scripts/progress.ts). */
interface Props {
  ids: string[];
  size?: 'sm' | 'md';
}
const { ids, size = 'md' } = Astro.props;
---

<div class:list={['progress', `progress-${size}`]} data-progress data-ids={ids.join(',')}>
  <div class="track" aria-hidden="true"><div class="bar" data-progress-bar></div></div>
  <span class="label"><span data-progress-count>0</span> из {ids.length}</span>
</div>

<style>
  .progress {
    display: flex;
    align-items: center;
    gap: 10px;
    min-width: 0;
  }
  .track {
    position: relative;
    flex: 1;
    height: 4px;
    border-radius: 99px;
    background: var(--surface-3);
    overflow: hidden;
  }
  .bar {
    position: absolute;
    inset: 0 auto 0 0;
    width: 0;
    border-radius: inherit;
    background: var(--accent);
    transition: width 0.3s ease;
  }
  .progress.is-complete .bar {
    background: var(--easy);
  }
  .label {
    font-size: 12.5px;
    color: var(--muted);
    white-space: nowrap;
    font-variant-numeric: tabular-nums;
  }
  .progress-md .track {
    height: 6px;
  }
  .progress-md .label {
    font-size: 13px;
  }
</style>

<script>
  import '../scripts/progress';
</script>
