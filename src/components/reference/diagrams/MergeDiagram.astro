---
/** Схема видов merge: две таблицы по ключу id и результат inner / left / right / outer. */
import Diagram from './Diagram.astro';
import MiniTable from './MiniTable.astro';

const results = [
  { how: 'inner', note: 'только общие ключи', rows: [[2, 'Борис', 'Тула'], [3, 'Вика', 'Сочи']], tones: [3, 3] },
  { how: 'left', note: 'все строки левой', rows: [[1, 'Аня', null], [2, 'Борис', 'Тула'], [3, 'Вика', 'Сочи']], tones: [1, 3, 3] },
  { how: 'right', note: 'все строки правой', rows: [[2, 'Борис', 'Тула'], [3, 'Вика', 'Сочи'], [4, null, 'Омск']], tones: [3, 3, 2] },
  { how: 'outer', note: 'все ключи обеих', rows: [[1, 'Аня', null], [2, 'Борис', 'Тула'], [3, 'Вика', 'Сочи'], [4, null, 'Омск']], tones: [1, 3, 3, 2] },
];
---

<Diagram
  caption="Строки сопоставляются по ключу id. Зелёным — ключи, которые есть в обеих таблицах; синим — только в левой, жёлтым — только в правой. Где пары нет, появляется NaN."
  label="Схема merge: левая таблица с id 1–3 и правая с id 2–4 дают четыре варианта результата: inner, left, right, outer"
>
  <div class="inputs">
    <MiniTable title="left" columns={['id', 'name']} rows={[[1, 'Аня'], [2, 'Борис'], [3, 'Вика']]} tones={[1, 3, 3]} />
    <MiniTable title="right" columns={['id', 'city']} rows={[[2, 'Тула'], [3, 'Сочи'], [4, 'Омск']]} tones={[3, 3, 2]} />
  </div>
  <div class="results">
    {
      results.map((r) => (
        <div class="result">
          <span class="how">
            <code>how="{r.how}"</code> — {r.note}
          </span>
          <MiniTable columns={['id', 'name', 'city']} rows={r.rows} tones={r.tones} />
        </div>
      ))
    }
  </div>
</Diagram>

<style>
  .inputs {
    display: flex;
    justify-content: center;
    gap: 28px;
    padding-bottom: 16px;
    margin-bottom: 16px;
    border-bottom: 1px dashed var(--border);
  }
  .results {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
    gap: 18px 20px;
    justify-items: center;
    align-items: start;
  }
  .result {
    display: grid;
    gap: 6px;
  }
  .how {
    font-size: 12px;
    color: var(--muted);
  }
  .how code {
    font-family: var(--font-mono);
    color: var(--accent-strong);
    background: none;
    border: 0;
    padding: 0;
  }
</style>
