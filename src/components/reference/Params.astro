---
/** Таблица параметров: `<Params items={[["axis", "ось, по которой…", "None"]]} />` — имя, что делает, по умолчанию. */
interface Props {
  items: [name: string, description: string, byDefault?: string][];
  title?: string;
}
const { items, title = 'Параметры' } = Astro.props;
---

<div class="params" role="table" aria-label={title}>
  <div class="row head" role="row">
    <span role="columnheader">Параметр</span>
    <span role="columnheader">Что делает</span>
    <span role="columnheader">По умолчанию</span>
  </div>
  {
    items.map(([name, description, byDefault]) => (
      <div class="row" role="row">
        <span role="cell" class="name">
          <code>{name}</code>
        </span>
        <span role="cell" class="desc">
          {description}
        </span>
        <span role="cell" class="default">
          {byDefault && byDefault !== '—' ? <code>{byDefault}</code> : <span class="none">обязательный</span>}
        </span>
      </div>
    ))
  }
</div>

<style>
  .params {
    margin: 0 0 20px;
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    overflow: hidden;
    font-size: 14px;
  }
  .row {
    display: grid;
    grid-template-columns: minmax(96px, 150px) 1fr minmax(96px, 130px);
    gap: 14px;
    padding: 10px 14px;
    align-items: baseline;
  }
  .row + .row {
    border-top: 1px solid var(--border);
  }
  .head {
    padding: 8px 14px;
    background: var(--surface-2);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .name code {
    color: var(--accent-strong);
  }
  .none {
    font-size: 12.5px;
    color: var(--faint);
  }
  @media (max-width: 560px) {
    .head {
      display: none;
    }
    .row {
      grid-template-columns: 1fr auto;
      gap: 4px 12px;
    }
    .desc {
      grid-column: 1 / -1;
      grid-row: 2;
    }
  }
</style>
